# Личные настройки Claude Code — не нужны в истории проекта
.claude/settings.local.json
.claude/launch.json

# Отчёты команды проверки (/proverka) — только на этом компьютере:
# репозиторий публичный, а в отчётах о безопасности могут быть описаны незакрытые дыры
.claude/team/

# Агенты и команда /proverka — тоже только на этом компьютере (владелец решил не публиковать)
.claude/agents/
.claude/skills/

# Личные инструкции для Claude на этом компьютере (описание команды проверки)
CLAUDE.local.md

# Список товаров для сайта собирается из data/products/*.json (tools/build_products.py):
# на GitHub — при публикации, на этом компьютере — при запуске предпросмотра
data/products.js

# Таблицы владельца (Excel и выгрузки) — на GitHub не попадают никогда: репозиторий публичный,
# а в таблице могут быть закупочные цены и пометки «для себя». ~$… — временные файлы открытого Excel
*.xlsx
*.xls
*.csv
~$*

# Файлы с паролями и ключами (например, для будущего сервера доставки или оплаты)
.env
.env.*

# Системный мусор Windows / macOS
Thumbs.db
Desktop.ini
.DS_Store
